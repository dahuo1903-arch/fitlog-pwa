# SQLite 数据库路径（本地开发默认使用相对 prisma/ 目录的 dev.db）
DATABASE_URL="file:./dev.db"

# 云端持久化数据库（Vercel 等 Serverless 部署时配置 Turso libSQL，本地开发留空即可继续用 dev.db）
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# 空间签名密钥（用于无密码个人隔离空间的 Cookie 与跨设备同步链接签名；云端部署建议填写任意随机字符串）
APP_SESSION_SECRET=""
# 可选：是否强制开启多用户独立空间隔离（云端部署自动开启，本地单人开发默认关闭）
# FITLOG_MULTI_SPACE="true"

# Gemini API（用于自然语言与拍照解析每日饮食）
# 获取地址: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# 可选覆盖模型，默认 gemini-4-hydrogen
GEMINI_MODEL="gemini-4-hydrogen"

# 训记 Open API（在训记 App -> 我的 -> 数据导出和导入 -> Open API 获取，前缀通常为 xjllm_）
# 注意：请务必先在训记 App 重置旧 Key，切勿提交到 Git
XUNJI_API_KEY=""

# WHOOP Developer API v2 OAuth 配置
# 获取地址: https://developer.whoop.com/
WHOOP_CLIENT_ID=""
WHOOP_CLIENT_SECRET=""
# 留空时自动根据当前请求 HTTPS/HTTP 域名拼装 /api/whoop/callback（云端与本地均需在 WHOOP 后台登记对应回调地址）
WHOOP_REDIRECT_URI="http://localhost:3000/api/whoop/callback"

# Apple Watch 快捷指令 / HealthKit Bridge 预留 Webhook 密钥（可选，供后续接入与多用户扩展）
APPLE_WATCH_WEBHOOK_SECRET=""

# 站点访问地址（用于 OAuth 回调重定向，云端部署设为 https://你的域名）
NEXT_PUBLIC_APP_URL="http://localhost:3000"
